# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg

# 编译产物 / 二进制引擎
*.pyd
*.so
*.dll

# 测试数据（RAW 体积大，按需保留）
assets/data/**/*.raw
reference/data/*.raw

# 二进制图像默认忽略；doc 目录下的图片（使用说明书截图/文档配图）需要上传
*.bmp
*.png
!doc/**/*.bmp
!doc/**/*.png

# 虚拟环境
.venv/
venv/
env/

# 本地临时验证目录
.tmp_test*/

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
